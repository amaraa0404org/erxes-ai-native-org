# REACT_APP_API_URL=http://localhost:4000
# NODE_ENV=development
# MONGO_URL=mongodb://localhost:27017/erxes
# NODE_OPTIONS=--max-old-space-size=1536
# ENABLED_PLUGINS=operation
# ENABLED_PLUGINS=operation,ai,sales,frontline
# DISABLE_CHANGE_STREAM=true

# === AI Plugin (Phase 1.1+) ===
# Configure these only if `ai` is in ENABLED_PLUGINS. ERXES_SECRET is the
# only required value when `ai` is enabled — generate it with
# `openssl rand -hex 32` and treat it like a production secret. Leaving
# ERXES_SECRET unset or shorter than 32 hex bytes causes ai_api to exit
# with code 1 at startup (see D-09).
AI_API_PORT=3320
AI_UI_PORT=3020
ERXES_SECRET=
AI_DEFAULT_VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
AI_EMBED_CONCURRENCY=4
AI_DEFAULT_CHAT_MODEL=
AI_DEFAULT_EMBED_MODEL=
AI_BUDGET_DEFAULT_USD=50
AI_MAX_TOOL_STEPS=8
AI_GUARDRAILS_STRICT=false
